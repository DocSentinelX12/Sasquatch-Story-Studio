{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "completed-record.schema.json",
  "title": "Completed Episode Record",
  "type": "object",
  "required": ["schema_version", "record_id", "episode_id", "episode_revision", "title", "completed_on", "canon_version", "asset_manifest", "final_assets", "production_provenance", "approvals", "release", "canon_changes"],
  "properties": {
    "record_id": {"type": "string", "pattern": "^COMPLETE-EP-[0-9]{3,}-R[0-9]+$"},
    "episode_id": {"type": "string", "pattern": "^EP-[0-9]{3,}$"},
    "episode_revision": {"type": "integer", "minimum": 1},
    "completed_on": {"type": "string", "format": "date"},
    "asset_manifest": {"const": "assets/asset-manifest.json"},
    "final_assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["asset_id", "asset_class", "kind", "status"],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^ASSET-[A-Z0-9-]+$"},
          "asset_class": {"const": "final_approved_production_asset"},
          "kind": {"type": "string"},
          "status": {"const": "verified"}
        }
      }
    },
    "production_provenance": {"type": "array", "items": {"type": "object"}},
    "approvals": {"type": "array", "items": {"type": "object"}},
    "release": {"type": "object"},
    "canon_changes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
