{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "continuity-check.schema.json",
  "title": "Episode Continuity Check",
  "type": "object",
  "required": ["schema_version", "episode_id", "check_status", "reviewed_canon_version", "checks", "canon_proposals", "blocking_notes"],
  "properties": {
    "episode_id": {"type": "string", "pattern": "^EP-[0-9]{3,}$"},
    "check_status": {"enum": ["not_started", "in_review", "passed", "blocked"]},
    "reviewed_canon_version": {"type": "string"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["check_id", "category", "requirement", "status", "notes"],
        "properties": {
          "status": {"enum": ["pending", "pass", "fail", "not_applicable"]}
        }
      }
    },
    "canon_proposals": {"type": "array", "items": {"type": "object"}},
    "blocking_notes": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
