{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sasquatch-story-studio/schemas/adapter-registry.json",
  "title": "Verified Production Adapter Registry",
  "type": "object",
  "required": ["adapters"],
  "properties": {
    "adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "license", "capabilities", "verification_status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1},
          "license_source": {"type": "string", "minLength": 1},
          "capabilities": {"type": "array", "items": {"type": "string"}},
          "verification_status": {"enum": ["verified", "pending", "rejected"]},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
