{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset-manifest.schema.json",
  "title": "Sasquatch Story Studio Asset Manifest",
  "type": "object",
  "required": ["schema_version", "manifest_id", "visual_authority", "barefoot_rule", "character_catalog_path", "family_registry_path", "asset_classes", "entries"],
  "properties": {
    "schema_version": {"type": "string"},
    "manifest_id": {"type": "string", "const": "ASSET-MANIFEST-SASQUATCH-STORY-STUDIO"},
    "character_catalog_path": {"type": "string", "const": "assets/characters/character-catalog.json", "description": "The scalable index that associates every registered reference image with the correct character."},
    "family_registry_path": {"type": "string", "const": "assets/characters/families/", "description": "Directory of family group records keeping family relationships connected."},
    "visual_authority": {"type": "string", "minLength": 20},
    "barefoot_rule": {"type": "string", "minLength": 20},
    "asset_classes": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["class", "authority", "description"],
        "properties": {
          "class": {"enum": ["creator_source_artwork", "approved_canon_reference", "ai_generated_test_material", "final_approved_production_asset"]},
          "authority": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {"$ref": "#/$defs/assetEntry"}
    }
  },
  "$defs": {
    "assetEntry": {
      "type": "object",
      "required": ["asset_id", "asset_class", "entity_ids", "purpose", "file", "provenance", "approval", "derived_from_asset_ids"],
      "properties": {
        "asset_id": {"type": "string", "pattern": "^ASSET-[A-Z0-9-]+$"},
        "asset_class": {"enum": ["creator_source_artwork", "approved_canon_reference", "ai_generated_test_material", "final_approved_production_asset"]},
        "entity_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}, "description": "CHAR-*, LOC-*, or FAMILY-* identifiers this asset depicts. Use FAMILY-* when individual characters are not yet identified."},
        "family_id": {"type": ["string", "null"], "pattern": "^FAMILY-[A-Z0-9-]+$"},
        "character_version_id": {"type": ["string", "null"], "pattern": "^VER-[A-Z0-9-]+$", "description": "Canonical character version (age/story period) this reference depicts, when known."},
        "purpose": {"enum": ["identity", "turnaround", "expression", "pose", "scale", "clothing", "color", "location", "prop", "animal", "storyboard", "shot_test", "final_frame", "final_video", "final_audio", "other"]},
        "file": {
          "type": "object",
          "required": ["uri_or_path", "media_type", "sha256"],
          "properties": {
            "uri_or_path": {"type": "string", "minLength": 1},
            "media_type": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
          }
        },
        "provenance": {
          "type": "object",
          "required": ["origin", "created_by", "registered_on"],
          "properties": {
            "origin": {"enum": ["creator", "approved_derivative", "ai_generation", "production_pipeline"]},
            "created_by": {"type": "string", "minLength": 1},
            "registered_on": {"type": "string", "format": "date"},
            "provider": {"type": ["string", "null"]},
            "provider_job_id": {"type": ["string", "null"]}
          }
        },
        "approval": {
          "type": "object",
          "required": ["status", "approved_by", "approved_on", "notes"],
          "properties": {
            "status": {"enum": ["registered", "creator_verified", "approved_for_reference", "approved_for_production", "rejected", "retired"]},
            "approved_by": {"type": ["string", "null"]},
            "approved_on": {"type": ["string", "null"], "format": "date"},
            "notes": {"type": "string"}
          }
        },
        "derived_from_asset_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^ASSET-[A-Z0-9-]+$"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
