# Sasquatch Story Studio — server-side secrets template.
# Copy to `.env` (git-ignored) and fill in only what you actually have.
# The application NEVER sends these values to the frontend.

# --- App configuration ------------------------------------------------------
# STUDIO_DB_PATH=.data/studio.db
# STUDIO_UPLOAD_ROOT=assets/studio-uploads

# --- Video generation providers (Phase 1: configuration contract only) ------
# SEEDANCE_API_KEY=
# SEEDANCE_API_BASE_URL=
# GEMINI_API_KEY=            # Google Veo (Gemini API credential)
# VEO_PROJECT_ID=
# VEO_LOCATION=
# WAN_API_KEY=
# WAN_API_BASE_URL=
