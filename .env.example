# Sasquatch Story Studio — server-side secrets template.
# Copy to `.env` (git-ignored) and fill in only what you actually have.
# The application NEVER sends these values to the frontend.

# --- App configuration ------------------------------------------------------
# STUDIO_DB_PATH=.data/studio.db
# STUDIO_UPLOAD_ROOT=assets/studio-uploads

# --- Video generation providers (Phase 5: real adapters) -------------------
# GEMINI_API_KEY=               # Google Veo (Gemini API)
# VEO_MODEL=veo-3.1-generate-preview
# SEEDANCE_API_KEY=             # Seedance via Volcano Engine Ark
# SEEDANCE_MODEL=doubao-seedance-2-0-260128
# SEEDANCE_API_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# WAN_API_KEY=                  # or DASHSCOPE_API_KEY (Alibaba Model Studio)
# WAN_REGION=singapore          # beijing | singapore | virginia
# WAN_API_BASE_URL=             # custom / self-hosted DashScope-compatible endpoint
# WAN_T2V_MODEL=wan2.2-t2v-plus
# WAN_I2V_MODEL=wan2.2-i2v-plus

# --- Development test adapter (clearly marked, no network) ------------------
# STUDIO_TEST_PROVIDER=1

# --- Local / self-hosted video lane (no per-video cloud credits) -----------
# LOCAL_VIDEO_API_URL=              # your Local Video Server (contract v1: /health, /generate, /jobs/{id})
# LOCAL_VIDEO_API_KEY=              # optional bearer token

# --- Cloud provider boundaries (contracts pending verification) ------------
# HIGGSFIELD_API_KEY=
# GEMINI_OMNI_VIDEO_MODEL=

# --- Local / self-hosted AUDIO lane (TTS/narration, free path) --------------
# LOCAL_AUDIO_API_URL=              # your Local Audio Server (contract v1: /health, /tts, /jobs/{id})
# LOCAL_AUDIO_API_KEY=

# --- Cloud audio boundaries (contracts pending verification) ----------------
# ELEVENLABS_API_KEY=
